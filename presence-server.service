[Unit]
Description=HexVPN presence server (contador de usuarios por servidor)
After=network.target

[Service]
Type=simple
# Cambia la clave por una tuya (misma que pones en AppConfig.presenceApiKey())
ExecStart=/opt/presence-server/presence-server -addr :8090 -apikey CAMBIA_ESTA_CLAVE
Restart=always
RestartSec=3
User=nobody
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
